# EXAMPLE VALUES ONLY. Copy to .env and edit locally; never commit the filled file.
# Select an actual supported release tag or digest before pulling or starting.
AUDIOBOOKSHELF_IMAGE=ghcr.io/advplyr/audiobookshelf:REPLACE_WITH_RELEASE
# Existing absolute directory accessible to Docker. This is not the author's path.
MEDIA_DIRECTORY=/absolute/path/to/your/media
# Change if already allocated on your Docker host.
APP_PORT=13378
# Use the timezone appropriate for your location.
TZ=Etc/UTC
